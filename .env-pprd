# Also write products/prices/transformed JSON + images to local disk.
SAVE_LOCAL=true
# Embed base64 image_content in the LOCAL transformed JSON too (needs SAVE_LOCAL=true).
# Off = base64 goes only to the uploaded storage JSON.
