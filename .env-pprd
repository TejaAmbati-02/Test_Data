# Enable Step 5 — embed `content` and index transformed rows into OpenSearch
INDEX_ENABLED=false

# OpenSearch (vector/kNN search index)
OPENSEARCH_HOST=opensearch-opensearch-dev.apps.asmonpeclr.np.asmo.com
